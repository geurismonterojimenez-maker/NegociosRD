# Production domain and server port.
PUBLIC_SITE_URL="https://tunegociord.com"
VITE_PUBLIC_SITE_URL="https://tunegociord.com"
APP_URL="https://tunegociord.com"
PORT="3000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gmail SMTP for invoices. Use a Google App Password, not your normal Gmail password.
GMAIL_USER="facturas@tunegociord.com"
GMAIL_APP_PASSWORD=""
INVOICE_FROM_NAME="Tu Negocio RD"
INVOICE_REPLY_TO="soporte@tunegociord.com"
INVOICE_BCC=""

# Checkout provider. Keep "demo" locally. Use "azul" or "azul_google_pay" in production.
CHECKOUT_PROVIDER="demo"

# Azul production credentials. Azul must enable your commerce account and domain first.
AZUL_MERCHANT_ID=""
AZUL_AUTH_KEY=""
AZUL_ENV="production"

# Google Pay via Azul. Azul must enable Google Pay for the merchant.
GOOGLE_PAY_MERCHANT_ID=""
GOOGLE_PAY_GATEWAY="pagosazul"
