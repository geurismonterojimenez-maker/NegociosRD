rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helper Functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { 
      return request.resource.data; 
    }
    function existing() { 
      return resource.data; 
    }
    function isSignedIn() { 
      return request.auth != null; 
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "jeuri905@gmail.com";
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity-Specific Schemas
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 200))
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.role is string && (data.role == 'FREE' || data.role == 'PRO')
        && (data.subscriptionStatus == null || (data.subscriptionStatus is string && (
          data.subscriptionStatus == 'FREE'
          || data.subscriptionStatus == 'PRO_ACTIVE'
          || data.subscriptionStatus == 'PRO_TRIAL'
          || data.subscriptionStatus == 'PRO_PENDING'
          || data.subscriptionStatus == 'PRO_EXPIRED'
          || data.subscriptionStatus == 'PRO_CANCELED'
        )))
        && (data.subscriptionPlan == null || (data.subscriptionPlan is string && (data.subscriptionPlan == 'FREE' || data.subscriptionPlan == 'PRO')))
        && (data.subscriptionBillingCycle == null || (data.subscriptionBillingCycle is string && (data.subscriptionBillingCycle == 'mensual' || data.subscriptionBillingCycle == 'anual' || data.subscriptionBillingCycle == 'trial')))
        && (data.subscriptionStartedAt == null || data.subscriptionStartedAt is string)
        && (data.subscriptionEndsAt == null || data.subscriptionEndsAt is string)
        && (data.subscriptionTrialEndsAt == null || data.subscriptionTrialEndsAt is string)
        && (data.subscriptionPaymentMethod == null || data.subscriptionPaymentMethod is string)
        && (data.subscriptionAutoRenew == null || data.subscriptionAutoRenew is bool)
        && (data.subscriptionLastAction == null || data.subscriptionLastAction is string)
        && (data.subscriptionUpdatedAt == null || data.subscriptionUpdatedAt is string)
        && (data.updatedAt == null || data.updatedAt is string)
        && (data.metadata == null || data.metadata is map);
    }

    function isValidPaymentMethod(data) {
      return data.id is string && data.id.size() <= 128
        && data.cardholderName is string && data.cardholderName.size() <= 20
        && data.brand is string && (data.brand == 'visa' || data.brand == 'mastercard' || data.brand == 'amex')
        && data.last4 is string && data.last4.matches('^[0-9]{4}$')
        && data.expiry is string && data.expiry.matches('^[0-9]{2}/[0-9]{2}$')
        && (data.createdAt == null || data.createdAt is string);
    }

    function isValidUsageLog(data) {
      return data.id is string
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.calculatorId is string && data.calculatorId.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.timestamp is string;
    }

    function isValidSubscriptionLog(data) {
      return data.id is string
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.previousTier is string && (data.previousTier == 'FREE' || data.previousTier == 'PRO')
        && data.newTier is string && (data.newTier == 'FREE' || data.newTier == 'PRO')
        && data.reason is string && data.reason.size() <= 300
        && data.timestamp is string;
    }

    // 4. Access Control Rules
    match /usageLogs/{logId} {
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && incoming().uid == request.auth.uid && isValidUsageLog(incoming());
      allow update, delete: if false;
    }

    match /subscriptionLogs/{logId} {
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && incoming().uid == request.auth.uid && isValidSubscriptionLog(incoming());
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      // Enforce immutability of uid and email fields during updates (Owner or Admin can update)
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'role',
          'updatedAt',
          'metadata',
          'displayName',
          'photoURL',
          'subscriptionStatus',
          'subscriptionPlan',
          'subscriptionBillingCycle',
          'subscriptionStartedAt',
          'subscriptionEndsAt',
          'subscriptionTrialEndsAt',
          'subscriptionPaymentMethod',
          'subscriptionAutoRenew',
          'subscriptionLastAction',
          'subscriptionUpdatedAt'
        ])
      );
      
      allow delete: if false; // Profile details are permanent

      // Sub-collection of payment methods
      match /paymentMethods/{methodId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(methodId) && isValidPaymentMethod(incoming());
        allow update: if false; // Modifying credit cards is forbidden; delete and recreate is cleaner and safer
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
